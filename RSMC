    def recalculate_and_update(self):
        try:
            # 1. Conversão para Sistema Internacional (SI)
            P = self.val_P * UNITS["force"][self.u_force]
            L = self.val_L * UNITS["pos"][self.u_pos]
            xP = self.val_xP * UNITS["pos"][self.u_pos]
            xB = self.val_xB * UNITS["pos"][self.u_pos]
            xC = self.val_xC * UNITS["pos"][self.u_pos]

            if abs(xC - xB) < 1e-6:
                return

            # 2. Equilíbrio Estático
            FA = P * (xC - xP) / (xC - xB)
            FB = P - FA

            state_A = "TRAÇÃO" if FA > 0 else ("COMPRESSÃO" if FA < 0 else "NEUTRO")
            state_B = "TRAÇÃO" if FB > 0 else ("COMPRESSÃO" if FB < 0 else "NEUTRO")

            # 3. Tensões Normais nas Barras
            area_A = math.pi * ((self.barraA_d * UNITS["dim"][self.u_dim]) / 2)**2
            area_B = math.pi * ((self.barraB_d * UNITS["dim"][self.u_dim]) / 2)**2

            sigma_A = abs(FA) / area_A if area_A > 0 else 0
            sigma_B = abs(FB) / area_B if area_B > 0 else 0

            # 4. Tensões de Cisalhamento nos Pinos
            area_pinoB = math.pi * ((self.pinoB_d * UNITS["dim"][self.u_dim]) / 2)**2
            m_B = 2 if self.pinoB_type == "Duplo" else 1
            tau_B = abs(FA) / (self.pinoB_n * m_B * area_pinoB) if area_pinoB > 0 else 0

            area_pinoC = math.pi * ((self.pinoC_d * UNITS["dim"][self.u_dim]) / 2)**2
            m_C = 2 if self.pinoC_type == "Duplo" else 1
            tau_C = abs(FB) / (self.pinoC_n * m_C * area_pinoC) if area_pinoC > 0 else 0

            # 5. Geometria da Viga e Flexão
            b_viga = self.viga_b * UNITS["dim"][self.u_dim]
            h_viga = self.viga_h * UNITS["dim"][self.u_dim]
            I_viga = (b_viga * (h_viga**3)) / 12.0
            y_max = h_viga / 2.0

            # 6. Esforços Internos (DEIS)
            x_arr = np.linspace(0, L, 500)
            V_arr = np.zeros_like(x_arr)
            M_arr = np.zeros_like(x_arr)

            for i, x in enumerate(x_arr):
                v_val = 0.0
                if x >= xP:
                    v_val -= P
                if x >= xB:
                    v_val += FA
                if x >= xC:
                    v_val += FB
                V_arr[i] = v_val

                m_val = 0.0
                if x >= xP:
                    m_val -= P * (x - xP)
                if x >= xB:
                    m_val += FA * (x - xB)
                if x >= xC:
                    m_val += FB * (x - xC)
                M_arr[i] = m_val

            sigma_flex_arr = (np.abs(M_arr) * y_max) / I_viga if I_viga > 0 else np.zeros_like(x_arr)

            idx_V_max = np.argmax(np.abs(V_arr))
            V_max = V_arr[idx_V_max]
            x_V_max = x_arr[idx_V_max]

            idx_M_max = np.argmax(np.abs(M_arr))
            M_max = M_arr[idx_M_max]
            x_M_max = x_arr[idx_M_max]

            idx_sig_max = np.argmax(sigma_flex_arr)
            sigma_flex_max = sigma_flex_arr[idx_sig_max]
            x_sig_max = x_arr[idx_sig_max]

            # 7. Atualização Gráfica
            self.draw_structural_schema(FA, FB)
            self.plot_deis(x_arr, V_arr, M_arr, sigma_flex_arr)

            # 8. Painel de Resultados Formato Texto
            conv_F = 1.0 / UNITS["force"][self.u_force]
            conv_S = 1.0 / UNITS["stress"][self.u_stress]
            conv_L = 1.0 / UNITS["pos"][self.u_pos]

            mat_v = MATERIALS_DB[self.mat_viga.get()]
            mat_a = MATERIALS_DB[self.mat_barraA.get()]
            mat_b = MATERIALS_DB[self.mat_barraB.get()]

            res_txt = f"""========================================
   REAÇÕES E EQUILÍBRIO ESTRUTURAL
========================================
• Carga Aplicada (P): {P*conv_F:.2f} {self.u_force}
• Reação em D (Barra A): {FA*conv_F:.2f} {self.u_force}
• Reação em E (Barra B): {FB*conv_F:.2f} {self.u_force}

========================================
   BARRA A (BD) - ESFORÇO E TENSÃO
========================================
• Força Axial NA: {abs(FA)*conv_F:.2f} {self.u_force}
• Indicação: {state_A}
• Tensão Normal σA: {sigma_A*conv_S:.2f} {self.u_stress}
• Escoamento σy: {mat_a['sigma_y']*conv_S:.2f} {self.u_stress}
• Status: {"✅ OK" if sigma_A <= mat_a['sigma_y'] else "❌ ESCOAMENTO"}

========================================
   BARRA B (CE) - ESFORÇO E TENSÃO
========================================
• Força Axial NB: {abs(FB)*conv_F:.2f} {self.u_force}
• Indicação: {state_B}
• Tensão Normal σB: {sigma_B*conv_S:.2f} {self.u_stress}
• Escoamento σy: {mat_b['sigma_y']*conv_S:.2f} {self.u_stress}
• Status: {"✅ OK" if sigma_B <= mat_b['sigma_y'] else "❌ ESCOAMENTO"}

========================================
   CISALHAMENTO NOS PINOS / REBITES
========================================
• Pino B:
  - Força Transmitida: {abs(FA)*conv_F:.2f} {self.u_force}
  - Tensão τB: {tau_B*conv_S:.2f} {self.u_stress}
  - Tipo: {self.pinoB_type} ({self.pinoB_n} pinos)

• Pino C:
  - Força Transmitida: {abs(FB)*conv_F:.2f} {self.u_force}
  - Tensão τC: {tau_C*conv_S:.2f} {self.u_stress}
  - Tipo: {self.pinoC_type} ({self.pinoC_n} pinos)

========================================
   FLEXÃO NA VIGA PRINCIPAL AC
========================================
• Momento Máximo |M|max: {abs(M_max)*conv_F*conv_L:.2f} {self.u_force}·{self.u_pos}
  -> Posição: x = {x_M_max*conv_L:.2f} {self.u_pos}
• Cortante Máximo |V|max: {abs(V_max)*conv_F:.2f} {self.u_force}
  -> Posição: x = {x_V_max*conv_L:.2f} {self.u_pos}
• Tensão Máx Flexão σ_flex: {sigma_flex_max*conv_S:.2f} {self.u_stress}
  -> Posição: x = {x_sig_max*conv_L:.2f} {self.u_pos}
• Status Viga: {"✅ OK" if sigma_flex_max <= mat_v['sigma_y'] else "❌ ESCOAMENTO"}
"""
            self.res_text.delete("1.0", tk.END)
            self.res_text.insert(tk.END, res_txt)

        except Exception as err:
            print(f"Erro de cálculo: {err}")

    def plot_deis(self, x_arr, V_arr, M_arr, sigma_flex_arr):
        for ax in self.axes:
            ax.clear()
            ax.set_facecolor('#1E1E2E')
            ax.tick_params(colors='#CDD6F4', labelsize=8)
            ax.xaxis.label.set_color('#CDD6F4')
            ax.yaxis.label.set_color('#CDD6F4')
            ax.grid(True, linestyle='--', alpha=0.3)

        conv_F = 1.0 / UNITS["force"][self.u_force]
        conv_S = 1.0 / UNITS["stress"][self.u_stress]
        conv_L = 1.0 / UNITS["pos"][self.u_pos]

        x_plot = x_arr * conv_L

        # Cortante V(x)
        self.axes[0].plot(x_plot, V_arr * conv_F, color='#89B4FA', linewidth=2)
        self.axes[0].fill_between(x_plot, V_arr * conv_F, color='#89B4FA', alpha=0.2)
        self.axes[0].set_ylabel(f"V ({self.u_force})", fontsize=8)
        self.axes[0].set_title("Diagrama de Esforço Cortante (DEC)", color='#CDD6F4', fontsize=9, fontweight='bold')

        # Momento M(x)
        self.axes[1].plot(x_plot, M_arr * conv_F * conv_L, color='#FAB387', linewidth=2)
        self.axes[1].fill_between(x_plot, M_arr * conv_F * conv_L, color='#FAB387', alpha=0.2)
        self.axes[1].set_ylabel(f"M ({self.u_force}·{self.u_pos})", fontsize=8)
        self.axes[1].set_title("Diagrama de Momento Fletor (DMF)", color='#CDD6F4', fontsize=9, fontweight='bold')

        # Tensão de Flexão
        self.axes[2].plot(x_plot, sigma_flex_arr * conv_S, color='#A6E3A1', linewidth=2)
        self.axes[2].fill_between(x_plot, sigma_flex_arr * conv_S, color='#A6E3A1', alpha=0.2)
        self.axes[2].set_ylabel(f"σ ({self.u_stress})", fontsize=8)
        self.axes[2].set_xlabel(f"Posição x ({self.u_pos})", fontsize=8)
        self.axes[2].set_title("Distribuição da Tensão de Flexão Máxima", color='#CDD6F4', fontsize=9, fontweight='bold')

        self.fig.tight_layout(pad=1.2)
        self.canvas_deis.draw_idle()

