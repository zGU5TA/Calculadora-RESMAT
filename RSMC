    def toggle_unit(self, unit_type, attr_name, btn_widget):
        units_dict = UNITS[unit_type]
        keys = list(units_dict.keys())
        curr_unit = getattr(self, f"u_{unit_type}")
        next_idx = (keys.index(curr_unit) + 1) % len(keys)
        new_unit = keys[next_idx]

        # Conversão do valor numérico
        old_val = getattr(self, attr_name)
        val_in_si = old_val * units_dict[curr_unit]
        new_val = val_in_si / units_dict[new_unit]

        setattr(self, f"u_{unit_type}", new_unit)
        setattr(self, attr_name, new_val)

        btn_widget.config(text=new_unit)
        self.entries[attr_name].set(f"{new_val:.2f}")
        self.recalculate_and_update()

